--- /dev/null
+++ b/common/wam_ffmpeg9.h
@@ -0,0 +1,19 @@
+/* WAM: API migration for the pinned FFmpeg 9 source closure. */
+#pragma once
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+static inline const void *wam_codec_config(const AVCodec *codec,
+                                           enum AVCodecConfig kind)
+{
+    const void *result = NULL;
+    if (avcodec_get_supported_config(NULL, codec, kind, 0, &result, NULL) < 0)
+        return NULL;
+    return result;
+}
+static inline uint8_t *wam_stream_side_data(const AVStream *stream,
+                                           enum AVPacketSideDataType kind)
+{
+    const AVPacketSideData *sd = av_packet_side_data_get(
+        stream->codecpar->coded_side_data, stream->codecpar->nb_coded_side_data, kind);
+    return sd ? sd->data : NULL;
+}
