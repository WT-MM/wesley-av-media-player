<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>

	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>

	<key>LSMinimumSystemVersion</key>
	<string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>

	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>

	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

	<!--
	  WAM registers itself as an alternate VIEWER for the media types it can
	  open so it is offered in Finder's "Open With" menu and can be set as
	  the default handler -- without disturbing QuickLook thumbnails or the
	  Finder icon for files it does not own:

	    - Every LSItemContentTypes entry below is either an Apple system UTI
	      (public.mpeg-4, com.apple.quicktime-movie, public.avi, public.mp3,
	      com.apple.m4a-audio, public.aac-audio, public.mpeg-2-transport-stream,
	      com.microsoft.waveform-audio) or a widely-registered third-party UTI
	      imported (never exported/owned) below via UTImportedTypeDeclarations,
	      conforming to the standard public.movie / public.audio ancestors so
	      the system's own QuickLook/thumbnail generators keep matching on the
	      inherited type.
	    - LSHandlerRank is "Alternate" everywhere: WAM can be picked as the
	      default app, but it never claims primary ownership of a type.
	    - None of these entries set CFBundleTypeIconFile. Doing so is exactly
	      what replaces Finder's per-file video-frame thumbnail with a static
	      document icon, so it is deliberately omitted; Finder/QuickLook keep
	      generating real frame thumbnails based on the file's UTI, regardless
	      of which app is the default handler.

	  That last point is about not SUPPRESSING a thumbnail the system can
	  already make. It is not a stance against supplying one the system
	  cannot: WAM.app/Contents/PlugIns/WAMThumbnail.appex is a QuickLook
	  thumbnail extension that decodes a real frame for the containers macOS
	  has no demuxer for -- Matroska above all. Same goal, opposite
	  direction. It claims only types Apple does not already thumbnail
	  (never public.mpeg-4 or com.apple.quicktime-movie) and no audio type.
	  See packaging/quicklook/README.md.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MPEG-4 Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-4</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>QuickTime Movie</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.quicktime-movie</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AVI Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.avi</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MPEG-2 Transport Stream</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-2-transport-stream</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Matroska Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.matroska.mkv</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>WebM Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.webmproject.webm</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MP3 Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mp3</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MPEG-4 Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.m4a-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AAC Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.aac-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Waveform Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.waveform-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>FLAC Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.xiph.flac</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ogg Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.xiph.ogg-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Opus Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.xiph.opus</string>
			</array>
		</dict>
		<!--
		  Everything below is a UTI macOS already registers itself (verified
		  with UTType(filenameExtension:) on the build host), so none of them
		  needs an entry in UTImportedTypeDeclarations. Each is a container the
		  bundled libmpv plays; the ones AVFoundation or the Matroska source
		  also admit are additionally playable on the native route. The rank
		  stays Alternate throughout, and no entry declares an icon, so
		  Finder/QuickLook keep generating their own thumbnails.

		  Deliberately NOT declared:
		    - .mk3d  -- macOS assigns it only a dynamic UTI, so there is no
		                stable identifier to claim.
		    - .asf   -- com.microsoft.advanced-systems-format conforms to
		                public.data rather than public.movie; claiming a bare
		                data type puts WAM in "Open With" for files it has no
		                business owning.
		    - .m3u / .m3u8 / .pls / .cue -- playlists, not media. Nothing in
		                this app parses them; only the mpv fallback follows
		                them, and public.m3u-playlist is likewise a
		                public.data type.
		-->
		<dict>
			<key>CFBundleTypeName</key>
			<string>iTunes Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.m4v-video</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Matroska Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.matroska.mka</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AVCHD Transport Stream</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.avchd-mpeg-2-transport-stream</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>MPEG Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>3GPP Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.3gpp</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Flash Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.flash.video</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Windows Media Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.windows-media-wmv</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ogg Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.xiph.ogg-video</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AIFF Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.aiff-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Windows Media Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.windows-media-wma</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AC-3 Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.ac3-audio</string>
				<string>public.enhanced-ac3-audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>CoreAudio Format</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.coreaudio-format</string>
			</array>
		</dict>
	</array>

	<!--
	  Imported (not exported/owned) declarations for the third-party UTIs
	  referenced above that are not always pre-registered by the OS itself.
	  Each conforms to the standard public.movie/public.audio ancestor so
	  system consumers (QuickLook's video/audio generators, Spotlight, etc.)
	  keep treating these files exactly as they did before WAM was installed
	  or set as default. WAM does NOT export/own these identifiers, so if
	  another installed app (e.g. VLC) already declares the same identifier,
	  LaunchServices simply merges the two declarations instead of
	  conflicting.
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.matroska.mkv</string>
			<key>UTTypeDescription</key>
			<string>Matroska Video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mkv</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.webmproject.webm</string>
			<key>UTTypeDescription</key>
			<string>WebM Video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>webm</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.xiph.flac</string>
			<key>UTTypeDescription</key>
			<string>FLAC Audio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>flac</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.xiph.ogg-audio</string>
			<key>UTTypeDescription</key>
			<string>Ogg Audio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<!-- macOS maps all three of these to org.xiph.ogg-audio,
					     .opus included, so the org.xiph.opus declaration
					     below is a belt-and-braces alias rather than the
					     path a real .opus file actually takes. -->
					<string>ogg</string>
					<string>oga</string>
					<string>opus</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.xiph.opus</string>
			<key>UTTypeDescription</key>
			<string>Opus Audio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>opus</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
