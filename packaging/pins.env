# Versions and names that CMake, the scripts and the workflows must agree on.
# Plain KEY=VALUE lines: CMake parses them into build/generated/wam_pins.hpp,
# shell scripts source this file, the workflows append it to $GITHUB_ENV, and
# every cache key hashes it.
WAM_MACOS_DEPLOYMENT_TARGET=13.3
WAM_QT_VERSION=6.11.1
WAM_XCODE_APP=/Applications/Xcode_26.3.0.app
WAM_FFMPEG_VERSION=9.0.1
WAM_FFMPEG_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635
WAM_NATIVE_AVCODEC_DYLIB=libavcodec-wamnative.63.dylib
WAM_NATIVE_AVUTIL_DYLIB=libavutil-wamnative.61.dylib
WAM_NATIVE_AVFORMAT_DYLIB=libavformat-wamnative.63.dylib
WAM_MPV_FALLBACK_DYLIB=WAMMpvFallback.dylib
